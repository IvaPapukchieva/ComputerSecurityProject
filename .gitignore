# SSH host private key: per-deployment secret, never commit
ssh_host_ed25519_key

# Client TOFU store: per-machine
client/known_hosts

# Per-machine known_hosts generated from each target's public key
tests/p3/*_known_hosts

# Python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/

# IDE / editor files (PyCharm .idea/*.xml, *.iml; VS Code)
.idea/
*.iml
.vscode/

# Partial downloads left by an interrupted client 'get'
*.part

# CTF exfiltrated test artifacts
stolen_flag.txt

# Targets: unpack your 5 groups locally (gitignored)
targets/*
!targets/.gitkeep

DSAI_Computer_Security_Group_Project_2026-1.pdf
Computer_Security_Group_Project_Phase_2.pdf


